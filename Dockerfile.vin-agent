FROM node:22-bookworm-slim

ARG CODEX_CLI_VERSION=0.145.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/observer \
    CODEX_HOME=/home/observer/.codex

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        git \
        python3 \
    && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
    && codex --version \
    && rm -rf /var/lib/apt/lists/* /root/.npm

RUN useradd --create-home --uid 10001 observer \
    && install -d --owner=observer --group=observer /home/observer/.codex

WORKDIR /workspace

COPY --chown=observer:observer \
    vin_agent_worker.py \
    vin_agent_schema.json \
    vin_online_search.py \
    vin_search.py \
    vin_unresolved.py \
    turbo_database.py \
    turbo_search.sqlite \
    ./

USER observer

CMD ["python3", "vin_agent_worker.py"]
